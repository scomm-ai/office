{
  "name": "@scomm-office/outlook-addin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "vite build && node ./scripts/render-manifest.mjs",
    "preview": "vite preview --port 5173",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.18.0",
    "@scomm-office/billing": "workspace:*",
    "@scomm-office/byoai": "workspace:*",
    "@scomm-office/config": "workspace:*",
    "@scomm-office/core": "workspace:*",
    "@scomm-office/crypto": "workspace:*",
    "@scomm-office/mail-security": "workspace:*",
    "@scomm-office/message-core": "workspace:*",
    "@scomm-office/crypto-openpgp": "workspace:*",
    "@scomm-office/capability-negotiation": "workspace:*",
    "@scomm-office/semantic-signatures": "workspace:*",
    "@scomm-office/identity": "workspace:*",
    "@scomm-office/idr": "workspace:*",
    "@scomm-office/microsoft-graph": "workspace:*",
    "@scomm-office/observability": "workspace:*",
    "@scomm-office/office": "workspace:*",
    "@scomm-office/policy": "workspace:*",
    "@scomm-office/protocol": "workspace:*",
    "@scomm-office/pubkeys": "workspace:*",
    "@scomm-office/semantics": "workspace:*",
    "@scomm-office/storage": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/office-js": "^1.0.421",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.0.2"
  }
}
