{
  "name": "@scomm-office/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@scomm-office/config": "workspace:*",
    "@scomm-office/core": "workspace:*",
    "@scomm-office/identity": "workspace:*",
    "@scomm-office/observability": "workspace:*",
    "@scomm-office/policy": "workspace:*",
    "@scomm-office/protocol": "workspace:*",
    "@scomm-office/pubkeys": "workspace:*",
    "@scomm-office/semantics": "workspace:*",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  }
}
