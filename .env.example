# SComm Office — environment template
# Copy to .env and adjust for local development

# Outlook add-in HTTPS port (default 5173). `pnpm dev` writes
# apps/outlook-addin/manifest/manifest.local.xml with matching URLs — sideload that file.
ADDIN_PORT=5173

# --- Vite apps (apps/outlook-addin, exposed as import.meta.env.VITE_*) ---
VITE_SCOMM_SERVER_URL=http://localhost:8787
VITE_PUBKEY_SERVER_URL=http://localhost:8787
# Production directory (read and write share this host; api.pubkey.scomm.ai does not resolve).
# Restart `pnpm dev` after changing these. On localhost the add-in proxies via /pubkey-read and /pubkey-write.
VITE_PUBKEY_READ_BASE_URL=https://pubkey.scomm.ai
VITE_PUBKEY_WRITE_BASE_URL=https://pubkey.scomm.ai
VITE_IDR_HOST=
VITE_IDR_SERVICE=ollama
VITE_BILLING_ORIGIN=
VITE_BILLING_PORTAL_URL=

# --- Server (apps/server) ---
PORT=8787
HOST=0.0.0.0
NODE_ENV=development
SCOMM_DEV_TOKEN=dev-token

# PostgreSQL — localhost:5433 with postgres/postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5433/scomm_office

# Logging
LOG_LEVEL=info
