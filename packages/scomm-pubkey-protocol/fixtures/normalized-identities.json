{
	"algorithm": "SComm email canonicalization + SHA-256 last-16-bytes UUID v8",
	"steps": [
		"Trim Unicode whitespace",
		"Unicode NFC",
		"Split on the last ASCII @",
		"Domain: Unicode lowercase, NFC",
		"Local: Unicode lowercase, NFC; drop from the first ASCII + onward",
		"Join local@domain",
		"SHA-256 UTF-8 bytes of the canonical string",
		"UUID v8 from last 16 digest bytes (version 8 + RFC variant)"
	],
